{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:burmalda:ml:v1",
  "title": "Burmalda ML contracts v1",
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_VERSION",
            "SEARCH_UNAVAILABLE",
            "TIMEOUT",
            "CONTEXT_MISMATCH",
            "MODEL_UNAVAILABLE",
            "BUDGET_EXCEEDED",
            "VERIFICATION_FAILED",
            "PERSISTENCE_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "Chunk": {
      "type": "object",
      "properties": {
        "chunk_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_version_id": {
          "type": "string",
          "format": "uuid"
        },
        "chunk_text": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "news",
            "bank_analytics",
            "expert",
            "regulator"
          ]
        },
        "source_role": {
          "enum": [
            "external",
            "bank",
            "expert"
          ]
        },
        "trust_level": {
          "enum": [
            "primary",
            "trusted",
            "standard",
            "unknown"
          ]
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "document_version_id",
        "chunk_text",
        "title",
        "canonical_url",
        "published_at",
        "retrieved_at",
        "source_id",
        "source_name",
        "source_type",
        "source_role",
        "trust_level"
      ],
      "additionalProperties": false
    },
    "RankedChunk": {
      "type": "object",
      "properties": {
        "chunk_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_version_id": {
          "type": "string",
          "format": "uuid"
        },
        "chunk_text": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "news",
            "bank_analytics",
            "expert",
            "regulator"
          ]
        },
        "source_role": {
          "enum": [
            "external",
            "bank",
            "expert"
          ]
        },
        "trust_level": {
          "enum": [
            "primary",
            "trusted",
            "standard",
            "unknown"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "retrieval_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "document_version_id",
        "chunk_text",
        "title",
        "canonical_url",
        "published_at",
        "retrieved_at",
        "source_id",
        "source_name",
        "source_type",
        "source_role",
        "trust_level",
        "rank",
        "retrieval_score"
      ],
      "additionalProperties": false
    },
    "ProfileFeature": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "feature_key": {
          "type": "string",
          "minLength": 1
        },
        "feature_value": {},
        "source_type": {
          "enum": [
            "company_field",
            "person_link",
            "payment",
            "derived"
          ]
        },
        "source_ref": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "feature_key",
        "feature_value",
        "source_type",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "Context": {
      "type": "object",
      "properties": {
        "business_context_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_type": {
          "enum": [
            "company",
            "group"
          ]
        },
        "company_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "role_code": {
          "enum": [
            "owner",
            "ceo",
            "cfo",
            "chief_accountant",
            "treasury",
            "other"
          ]
        },
        "profile_data": {
          "type": "object"
        },
        "profile_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProfileFeature"
          },
          "minItems": 0
        }
      },
      "required": [
        "business_context_id",
        "subject_type",
        "company_id",
        "group_id",
        "profile_id",
        "profile_version",
        "role_code",
        "profile_data",
        "profile_features"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "subject_type": {
              "const": "company"
            },
            "company_id": {
              "type": "string",
              "format": "uuid"
            },
            "group_id": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "subject_type": {
              "const": "group"
            },
            "company_id": {
              "type": "null"
            },
            "group_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "geography": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "code",
              "name"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "status": {
          "enum": [
            "candidate",
            "confirmed",
            "disputed",
            "rejected"
          ]
        },
        "document_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "event_type",
        "title",
        "summary",
        "occurred_at",
        "geography",
        "status",
        "document_version_ids",
        "confidence"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "evidence_type": {
          "enum": [
            "document_chunk",
            "profile_feature"
          ]
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "fact_id": {
          "type": "null"
        },
        "profile_feature_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_role": {
          "enum": [
            "support",
            "contradict",
            "context"
          ]
        },
        "quote_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidence_type",
        "chunk_id",
        "fact_id",
        "profile_feature_id",
        "evidence_role",
        "quote_text"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "evidence_type": {
              "const": "document_chunk"
            },
            "chunk_id": {
              "type": "string",
              "format": "uuid"
            },
            "profile_feature_id": {
              "type": "null"
            },
            "quote_text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "profile_feature"
            },
            "chunk_id": {
              "type": "null"
            },
            "profile_feature_id": {
              "type": "string",
              "format": "uuid"
            },
            "quote_text": {
              "type": "null"
            }
          }
        }
      ]
    },
    "Claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "claim_type": {
          "enum": [
            "relevance",
            "impact",
            "consequence",
            "action",
            "bank_view"
          ],
          "description": "Назначение утверждения в разборе; не заменяет knowledge_type."
        },
        "claim_text": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "knowledge_type": {
          "enum": [
            "FACT",
            "ALFA_ANALYTICS",
            "AI_INFERENCE",
            "FORECAST"
          ]
        },
        "verification_status": {
          "enum": [
            "SUPPORTED",
            "PARTIALLY_SUPPORTED"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "time_horizon": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "claim_type",
        "claim_text",
        "position",
        "confidence",
        "evidence",
        "knowledge_type",
        "verification_status",
        "assumptions",
        "time_horizon"
      ],
      "additionalProperties": false
    },
    "Insight": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "business_context_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "analysis_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "verified"
          ]
        },
        "impact_kind": {
          "enum": [
            "risk",
            "opportunity",
            "mixed",
            "neutral"
          ]
        },
        "relevance_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "impact_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "time_horizon": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "consequences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "probability": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "time_horizon": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "description",
              "probability",
              "time_horizon"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action",
              "priority",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "score_components": {
          "type": "object"
        },
        "bank_view": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "bank_view_document_version_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "business_context_id",
        "event_id",
        "analysis_run_id",
        "version",
        "status",
        "impact_kind",
        "relevance_score",
        "impact_score",
        "confidence",
        "severity",
        "time_horizon",
        "summary",
        "consequences",
        "recommended_actions",
        "score_components",
        "bank_view",
        "bank_view_document_version_id",
        "claims"
      ],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_message_id": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "const": "assistant"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 0
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "citation_order": {
                "type": "integer",
                "minimum": 1
              },
              "chunk_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "claim_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "citation_order",
              "chunk_id",
              "claim_id"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "conversation_id",
        "parent_message_id",
        "role",
        "content",
        "claims",
        "citations"
      ],
      "additionalProperties": false
    },
    "FollowUp": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_message_id": {
          "type": "string",
          "format": "uuid"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "history_through_message_id": {
          "type": "string",
          "format": "uuid"
        },
        "initial_insight_id": {
          "type": "string",
          "format": "uuid"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "claims": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Claim"
                },
                "minItems": 0
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "citation_order": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "chunk_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uuid"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "claim_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uuid"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "citation_order",
                    "chunk_id",
                    "claim_id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "chunks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Chunk"
                }
              }
            },
            "required": [
              "id",
              "role",
              "content",
              "claims",
              "citations",
              "chunks"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "initial_insight": {
          "$ref": "#/$defs/InsightSnapshot"
        }
      },
      "required": [
        "conversation_id",
        "request_message_id",
        "question",
        "history_through_message_id",
        "initial_insight_id",
        "history",
        "initial_insight"
      ],
      "additionalProperties": false
    },
    "SearchRequest": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "v1"
        },
        "trace_id": {
          "type": "string",
          "format": "uuid"
        },
        "business_context_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "filters": {
          "type": "object",
          "properties": {
            "published_from": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "published_to": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 0
            },
            "source_roles": {
              "type": "array",
              "items": {
                "enum": [
                  "external",
                  "bank",
                  "expert"
                ]
              },
