          "dashboardUid": "ingestion-overview",
          "panelId": 14
        },
        {
          "uid": "ingestion-poll-errors",
          "title": "Повторяются неудачные опросы",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "sum(increase(ingestion_source_polls_total{status=~\"FAILED|PARTIAL\"}[3h])) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "$A > 2",
                "type": "math",
                "refId": "B"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "component": "ingestion"
          },
          "annotations": {
