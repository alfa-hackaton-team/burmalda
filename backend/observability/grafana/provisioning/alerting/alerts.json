{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Source ingestion",
      "folder": "Ingestion",
      "interval": "1m",
      "rules": [
        {
          "uid": "ingestion-worker-down",
          "title": "Воркер недоступен",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "1 - min(up{job=\"worker\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "$A > 0",
                "type": "math",
                "refId": "B"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "2m",
          "labels": {
            "severity": "critical",
            "component": "ingestion"
          },
          "annotations": {
            "summary": "Воркер недоступен"
          },
          "dashboardUid": "ingestion-overview",
          "panelId": 1
        },
        {
          "uid": "ingestion-observer-down",
