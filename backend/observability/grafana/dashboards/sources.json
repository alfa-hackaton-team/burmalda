    {
      "id": 18,
      "title": "Источники",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT name AS \"Источник\",health AS \"Состояние\",round(extract(epoch from now()-coalesce(last_success_at,created_at)))::bigint AS \"Секунд без успеха\",coalesce(last_error,'') AS \"Ошибка\" FROM sources WHERE enabled ORDER BY CASE WHEN health='HEALTHY' THEN 1 ELSE 0 END,last_success_at NULLS FIRST LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
