        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by(job)(rate(ingestion_postgres_pool_acquire_seconds_total{job=~\"$service\"}[$__rate_interval])) / clamp_min(sum by(job)(rate(ingestion_postgres_pool_acquires_total{job=~\"$service\"}[$__rate_interval])), 0.000000001)",
