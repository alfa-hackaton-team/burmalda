      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "description": "Успешные операции за час. Время включает ожидание постановки и переобработку старых материалов.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "ingestion_document_processing_seconds{stage=\"ingest_to_search\"}",
          "legendFormat": "q={{quantile}}",
          "refId": "A"
