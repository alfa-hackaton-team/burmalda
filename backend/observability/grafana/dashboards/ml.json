    {
      "id": 10,
      "title": "Причины отказов · за час",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "description": "Сохранённый last_error_code финальных FAILED. Неизвестные коды объединяются в OTHER, отсутствующие — UNKNOWN. Quality-отказ показывается под кодом, который вернул ML; текст ошибки остаётся в логах.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "ingestion_ml_failures_last_hour",
          "legendFormat": "{{code}}",
          "refId": "A",
          "instant": true,
          "range": false
