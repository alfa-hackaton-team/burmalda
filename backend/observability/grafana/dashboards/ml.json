      "title": "Попытки POST/GET · в минуту",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "description": "Попытки воркера, включая polling; не скорость обработки документов.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
