      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,operation)(rate(ingestion_s3_operation_duration_seconds_bucket{job=~\"$service\",operation=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
