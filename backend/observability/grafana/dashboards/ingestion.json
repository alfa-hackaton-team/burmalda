      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT name AS \"Источник\", health AS \"Состояние\", round(extract(epoch from now()-coalesce(last_success_at,created_at)))::bigint AS \"Секунд без успеха\", greatest(round(extract(epoch from now()-next_poll_at))::bigint,0) AS \"Просрочено, с\", coalesce(last_error,'') AS \"Последняя ошибка\", id::text AS \"ID\" FROM sources WHERE enabled ORDER BY CASE WHEN health='HEALTHY' THEN 1 ELSE 0 END, last_success_at NULLS FIRST LIMIT 50"
        }
      ],
