      "description": "Только завершённые FAILED; не количество попыток POST/GET.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(ingestion_ml_failures_last_hour) or on() (0 * (ingestion_pipeline_collection_up == 1))",
