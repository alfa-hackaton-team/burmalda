      "id": 9,
      "title": "Очереди · ожидают",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(ingestion_article_fetch_jobs{status=~\"QUEUED|RETRY\"})",
          "legendFormat": "Статьи",
          "refId": "A"
        },
        {
          "expr": "sum(ingestion_processing_jobs{status=~\"QUEUED|RETRY\"})",
          "legendFormat": "ML",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Документ → поиск · p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "description": "Успешные операции за последний час: completed_at минус fetched_at. Включает ожидание включения ML и переобработку.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "ingestion_document_processing_seconds{stage=\"ingest_to_search\",quantile=\"0.95\"}",
