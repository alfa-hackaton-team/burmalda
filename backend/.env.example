DATABASE_URL=postgres://burmalda:burmalda@127.0.0.1:5432/burmalda?sslmode=disable
BACKEND_CONFIG_FILE=./config.yaml
HTTP_ADDR=127.0.0.1:18080
# Generate once with: openssl rand -base64 32
CURSOR_SIGNING_KEY=
# Comma-separated exact browser origins; wildcards and URL paths are rejected.
API_ALLOWED_ORIGINS=http://127.0.0.1:5173
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
SOURCE_POLL_LEASE=2m
SOURCE_POLL_IDLE=5s
SOURCE_POLL_REAP_BATCH=100
RAW_STORAGE_BACKEND=postgres
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
# Set the exact version accepted by the ML deployment's ML_PIPELINE_VERSIONS.
ML_PIPELINE_VERSION=
ML_MAX_TEXT_BYTES=131072
# ML_BASE_URL=http://ml:8000
# ML_SERVICE_TOKEN=replace-with-a-secret
