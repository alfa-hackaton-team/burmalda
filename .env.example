# Local development credentials only. Copy to .env and replace the model key.
POSTGRES_PASSWORD=local_admin_password_change_me
BACKEND_RUNTIME_PASSWORD=local_backend_password_change_me
ML_RUNTIME_PASSWORD=local_runtime_password_change_me
ML_SERVICE_TOKEN=local_service_token_change_me

# Obtain this key from the hackathon organizers. Never commit a real key.
ML_LLM_API_KEY=replace_with_your_team_key
ML_LLM_BASE_URL=https://changellenge.up.railway.app/v1
ML_LLM_EVENT_MODEL=z-ai/glm-5.3-flash
ML_LLM_EVENT_VERIFIER_MODEL=qwen/qwen3.6-35b-a3b
ML_EVENT_PIPELINE_CONFIG_VERSION=event-extraction-v1

# Product API: same version in Go and ML, actual HTTP API in the frontend.
ML_ANALYSIS_CONFIG_VERSION=ml-analysis-v1
ML_ANALYSIS_RETRIEVAL_MODE=event-evidence
ML_LLM_MODEL=z-ai/glm-5.3-flash
ML_LLM_VERIFIER_MODEL=qwen/qwen3.6-35b-a3b
FRONTEND_DATA_MODE=api
