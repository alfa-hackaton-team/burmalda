# api: real Go API; demo: opt-in synthetic local data.
VITE_DATA_MODE=api
# Empty uses same-origin /v0.1 (the Vite dev proxy points to localhost:18080).
VITE_API_BASE_URL=
# Optional alternative login route (for example, a future same-origin OIDC start).
VITE_AUTH_START_URL=
# Keep false when Go self-registration is disabled.
VITE_SELF_REGISTRATION_ENABLED=false
