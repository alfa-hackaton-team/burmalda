# demo: synthetic local data; api: the real Go API, without automatic mock fallback.
VITE_DATA_MODE=demo
# Empty uses same-origin /v0.1 (the Vite dev proxy points to localhost:18080).
VITE_API_BASE_URL=
# Set only after the server-side login flow is deployed. Prefer a same-origin
# /auth/start endpoint that creates session_id and csrf_token cookies.
VITE_AUTH_START_URL=
